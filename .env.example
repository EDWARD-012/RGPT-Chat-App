# Copy this file to .env for local development.
# On Vercel, set the same names in Project Settings > Environment Variables.
# Never commit real values.

# Required on Vercel (Production and Preview)

# A long random string. One way to make one:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Gemini API key from Google AI Studio.
GEMINI_API_KEY=

# OAuth 2.0 web client ID from Google Cloud Console. The frontend build uses
# it for the sign-in button and the backend uses it to verify sign-ins.
VITE_GOOGLE_CLIENT_ID=

# Postgres connection string. Vercel adds it for you when a Neon database is
# connected to the project from the Marketplace. Leave it empty locally to use
# SQLite.
DATABASE_URL=

# Optional

# GEMINI_MODEL=gemini-3.8-flash
# Comma-separated, tried in order when the main model is busy or rate limited.
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# MESSAGES_PER_HOUR=40
# CHAT_HISTORY_LIMIT=30
# Only needed if the backend should use a different client ID than the frontend.
# GOOGLE_CLIENT_ID=
# Set all three before the first deploy to create a Django admin user.
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=
# Comma-separated, only needed for a custom domain.
# DJANGO_ALLOWED_HOSTS=
# DJANGO_CSRF_TRUSTED_ORIGINS=

# Local development only. Do not set this on Vercel.
DJANGO_DEBUG=1
